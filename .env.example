# Bu dosyayi ".env" olarak kopyalayip kendi degerlerinizi yazin.
# .env dosyasi .gitignore'da, git'e gonderilmez.

# --- LLM ---
# LLM'i tamamen kapatmak icin 0 yapin (sadece OCR calisir, data alani bos doner).
# torch kurulu degilse zaten otomatik kapanir, servis cokmez.
ENABLE_LLM=1

MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# Fine-tune sonrasi LoRA adaptor klasoru. Bos birakilirsa base model kullanilir.
ADAPTER_PATH=

# 4-bit quantization. Sadece GPU + bitsandbytes varken 1 yapin.
LOAD_IN_4BIT=0

# Tamamen cevrimdisi calismak icin 1 yapin.
# Modeller bir kere indirildikten sonra internete ihtiyac kalmaz; bu ayar
# transformers'in her acilista HuggingFace'e "yeni surum var mi" diye
# sormasini da engeller. Internet yokken bu birkac saniyelik bekleme demek.
# Onbellek: ~/.cache/huggingface (Qwen ~950 MB)
HF_HUB_OFFLINE=0

# --- OCR ---
OCR_LANG=en

# PaddleOCR model cache dizini.
# Windows'ta kullanici adiniz ASCII disi karakter iceriyorsa (ornek: Betül)
# paddle model dosyalarini acamaz. Kod bunu otomatik algilayip C:\paddlex_cache
# kullanir; farkli bir yer istiyorsaniz burada belirtin.
# PADDLE_PDX_CACHE_HOME=C:\paddlex_cache
